    <string name="bpx1_overview_title">Mi Home BPX1</string>
    <string name="bpx1_overview_body">먼저 Bluetooth로 ihealth.bpm.bpx1을 찾은 다음 키를 저장하고 새 측정 브로드캐스트를 수신합니다.</string>
    <string name="bpx1_status_configured">기기 및 키 저장됨</string>
    <string name="bpx1_status_not_configured">기기를 선택하고 바인드 키를 입력하세요</string>
    <string name="bpx1_bluetooth_ready">Bluetooth 사용 가능</string>
    <string name="bpx1_bluetooth_disabled">Bluetooth가 꺼져 있습니다</string>
    <string name="bpx1_bluetooth_unsupported">Bluetooth Low Energy를 지원하지 않습니다</string>
    <string name="bpx1_enable_bluetooth">Bluetooth 켜기</string>
    <string name="bpx1_permission_title">주변 기기 허용</string>
    <string name="bpx1_permission_body">검색과 연결에는 주변 기기 권한이 필요합니다. Android 11 이하에서는 위치 권한도 필요합니다.</string>
    <string name="bpx1_permission_action">권한 허용</string>
    <string name="bpx1_config_title">기기 및 키</string>
    <string name="bpx1_config_desc">MAC 주소로 혈압계를 지정하고 16바이트 바인드 키로 측정 브로드캐스트를 복호화합니다.</string>
    <string name="bpx1_mac_label">Bluetooth MAC 주소</string>
    <string name="bpx1_mac_hint">AA:BB:CC:DD:EE:FF</string>
    <string name="bpx1_mac_invalid">12자리 16진수 MAC 주소를 입력하세요</string>
    <string name="bpx1_bind_key_label">바인드 키</string>
    <string name="bpx1_bind_key_hint">32자리 16진수 문자</string>
    <string name="bpx1_bind_key_saved">키가 안전하게 저장되었습니다. 비워 두면 현재 키를 유지합니다</string>
    <string name="bpx1_bind_key_new_device">MAC이 변경되었습니다. 새 기기의 바인드 키를 입력하세요</string>
    <string name="bpx1_bind_key_invalid">16바이트(32자리 16진수) 바인드 키를 입력하세요</string>
    <string name="bpx1_bind_key_source">이미 연결된 기기의 로컬 설정에서 바인드 키를 내보내세요. Wi-Fi 또는 Mi Home 계정 암호가 아닙니다.</string>
    <string name="bpx1_bind_key_show">바인드 키 표시</string>
    <string name="bpx1_bind_key_hide">바인드 키 숨기기</string>
    <string name="bpx1_save_config">설정 저장</string>
    <string name="bpx1_clear_config">기기 제거</string>
    <string name="bpx1_clear_config_confirmation">이 휴대전화에서 BPX1 MAC 주소와 암호화된 바인드 키를 삭제하고 자동 가져오기를 중지합니다. 기존 건강 기록은 삭제되지 않습니다.</string>
    <string name="bpx1_actions_title">검색 및 Bluetooth 확인</string>
    <string name="bpx1_actions_desc">혈압계를 켠 상태로 휴대전화 가까이에 두세요. 20초 검색으로 기기를 찾고 새 측정값을 수신합니다.</string>
