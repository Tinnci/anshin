    <string name="bpx1_overview_title">米家 BPX1</string>
    <string name="bpx1_overview_body">先通过蓝牙发现 ihealth.bpm.bpx1，再保存设备密钥并监听新的测量广播。</string>
    <string name="bpx1_status_configured">设备与密钥已保存</string>
